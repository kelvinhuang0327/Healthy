{
  "name": "healthy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "web:build": "npm run build --workspace @healthy/web",
    "web:dev": "npm run dev --workspace @healthy/web",
    "web:lint": "npm run lint --workspace @healthy/web",
    "web:typecheck": "npm run typecheck --workspace @healthy/web",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1"
  },
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=24.18.0 <25"
  }
}
